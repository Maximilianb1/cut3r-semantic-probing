{
  "experiment": "segmentation-dinov2",
  "backbone": {
    "kind": "dinov2",
    "weights": "trained",
    "options": {
      "variant": "dinov2_vitb14",
      "image_size": 518,
      "device": "cuda"
    }
  },
  "probe_cache": {
    "dir": "${CUT3R_CACHE_ROOT}/probe/dinov2-vitb14"
  },
  "data": {
    "manifest_dir": "${CUT3R_ARTIFACT_ROOT}/manifests/full51-part-a-v1",
